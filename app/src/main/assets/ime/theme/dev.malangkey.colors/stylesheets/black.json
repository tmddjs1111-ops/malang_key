{
  "$schema": "https://schemas.florisboard.org/snygg/v2/stylesheet",
  "@defines": {
    "--bg": "#1c1b1d",
    "--key-bg": "#2e2d31",
    "--key-fg": "#f4f1ea",
    "--key-bg-pressed": "#45434a",
    "--action-bg": "#f4f1ea",
    "--action-fg": "#1c1b1d",
    "--action-bg-pressed": "#d6d2c8",
    "--shape": "rounded-corner(12dp, 12dp, 12dp, 12dp)"
  },
  "window": { "background": "var(--bg)" },
  "keyboard": { "background": "var(--bg)" },
  "key": {
    "background": "var(--key-bg)",
    "foreground": "var(--key-fg)",
    "font-size": "20sp",
    "shape": "var(--shape)",
    "border-width": "1dp",
    "border-color": "#3d3b41",
    "shadow-elevation": "1dp",
    "shadow-color": "rgba(0, 0, 0, 0.4)"
  },
  "key:pressed": { "background": "var(--key-bg-pressed)" },
  "key[code=-9716]": { "background": "var(--action-bg)", "foreground": "var(--action-fg)" },
  "key[code=-9716]:pressed": { "background": "var(--action-bg-pressed)" },
  "key[code=10]": { "background": "var(--action-bg)", "foreground": "var(--action-fg)" },
  "key[code=10]:pressed": { "background": "var(--action-bg-pressed)" },
  "key[code=-9717]": { "background": "var(--action-bg)", "foreground": "var(--action-fg)" },
  "key[code=-9717]:pressed": { "background": "var(--action-bg-pressed)" },
  "key[code=-1]": { "background": "var(--key-bg-pressed)", "foreground": "var(--key-fg)" },
  "key[code=-5]": { "background": "var(--key-bg-pressed)", "foreground": "var(--key-fg)" },
  "key-popup-box": { "background": "var(--key-bg)", "foreground": "var(--key-fg)", "shape": "var(--shape)", "shadow-elevation": "2dp" },
  "key-popup-element:focus": { "background": "var(--key-bg-pressed)" },
  "smartbar": { "background": "var(--bg)" },
  "smartbar-item": { "foreground": "var(--key-fg)" },
  "smartbar-action-key": { "foreground": "var(--key-fg)" },
  "smartbar-action-key-icon": { "foreground": "var(--key-fg)" },
  "smartbar-action-tile": { "foreground": "var(--key-fg)" },
  "smartbar-action-tile-icon": { "foreground": "var(--key-fg)" },
  "smartbar-action-tile-text": { "foreground": "var(--key-fg)" },
  "smartbar-shared-actions-toggle": { "foreground": "var(--key-fg)" },
  "smartbar-extended-actions-toggle": { "foreground": "var(--key-fg)" },
  "clipboard-item-popup": { "background": "var(--bg)", "foreground": "var(--key-fg)", "shape": "var(--shape)", "shadow-elevation": "4dp" },
  "clipboard-item-actions": { "background": "var(--bg)", "foreground": "var(--key-fg)", "shape": "var(--shape)", "shadow-elevation": "4dp" },
  "clipboard-item-action": { "foreground": "var(--key-fg)" },
  "clipboard-item-action-icon": { "foreground": "var(--key-fg)" },
  "clipboard-item-action-text": { "foreground": "var(--key-fg)" },
  "smartbar-candidate-word": { "padding": "10dp 0dp", "margin": "4dp" },
  "key-hint": { "font-size": "12sp" }
}
