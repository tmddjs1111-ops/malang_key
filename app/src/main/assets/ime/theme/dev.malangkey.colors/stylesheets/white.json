{
  "$schema": "https://schemas.florisboard.org/snygg/v2/stylesheet",
  "@defines": {
    "--bg": "#FDF8ED",
    "--key-bg": "#212121",
    "--key-fg": "#FFFFFF",
    "--key-bg-pressed": "#424242",
    "--action-bg": "#333333",
    "--action-fg": "#FFFFFF",
    "--action-bg-pressed": "#505050",
    "--shape": "rounded-corner(12dp, 12dp, 12dp, 12dp)"
  },
  "window": { "background": "var(--bg)" },
  "keyboard": { "background": "var(--bg)" },
  "key": {
    "background": "var(--key-bg)",
    "foreground": "var(--key-fg)",
    "font-size": "20sp",
    "shape": "var(--shape)",
    "shadow-elevation": "1dp",
    "shadow-color": "rgba(0, 0, 0, 0.15)"
  },
  "key:pressed": { "background": "var(--key-bg-pressed)" },
  "key[code=10]": { "background": "#5D4037", "foreground": "#FFFFFF" },
  "key[code=10]:pressed": { "background": "#8D6E63" },
  "key[code=-1]": { "background": "var(--action-bg)", "foreground": "var(--action-fg)" },
  "key[code=-5]": { "background": "var(--action-bg)", "foreground": "var(--action-fg)" },
  "smartbar": { "background": "var(--bg)" },
  "smartbar-item": { "foreground": "#5D4037" }
}
