{
  "$schema": "https://schemas.florisboard.org/snygg/v2/stylesheet",
  "@defines": {
    "--bg": "#fcf5d6",
    "--key-bg": "#fcf5d6",
    "--key-fg": "#311d18",
    "--key-bg-pressed": "#e8e1c3",
    "--action-bg": "#311d18",
    "--action-fg": "#fcf5d6",
    "--action-bg-pressed": "#4a2d25",
    "--shape": "rounded-corner(12dp, 12dp, 12dp, 12dp)"
  },
  "window": { "background": "var(--bg)" },
  "keyboard": { "background": "var(--bg)" },
  "key": {
    "background": "var(--key-bg)",
    "foreground": "var(--key-fg)",
    "font-size": "20sp",
    "shape": "var(--shape)",
    "shadow-elevation": "1dp",
    "shadow-color": "rgba(0, 0, 0, 0.1)"
  },
  "key:pressed": { "background": "var(--key-bg-pressed)" },
  "key[code=10]": { "background": "var(--action-bg)", "foreground": "var(--action-fg)" },
  "key[code=10]:pressed": { "background": "var(--action-bg-pressed)" },
  "key[code=-1]": { "background": "var(--key-bg-pressed)", "foreground": "var(--key-fg)" },
  "key[code=-5]": { "background": "var(--key-bg-pressed)", "foreground": "var(--key-fg)" },
  "smartbar": { "background": "var(--bg)" },
  "smartbar-item": { "foreground": "var(--key-fg)" },
  "clipboard-item-popup": { "background": "var(--bg)", "foreground": "var(--key-fg)", "shape": "var(--shape)", "shadow-elevation": "4dp" },
  "clipboard-item-actions": { "background": "var(--bg)", "foreground": "var(--key-fg)", "shape": "var(--shape)", "shadow-elevation": "4dp" },
  "clipboard-item-action": { "foreground": "var(--key-fg)" },
  "clipboard-item-action-icon": { "foreground": "var(--key-fg)" },
  "clipboard-item-action-text": { "foreground": "var(--key-fg)" }
}
